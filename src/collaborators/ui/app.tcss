Screen {
    background: $background;
}

/* ---- bars ------------------------------------------------------------- */
#topbar {
    height: 1;
    background: $panel;
    color: $foreground;
}
#topbar {
    color: $primary;
}
#statsbar {
    height: 1;
    background: $panel;
    color: $foreground;
}

/* ---- layout --------------------------------------------------------------- */
#teams {
    height: 1fr;
}
#teams.-single ContentTabs {
    display: none;
}
#teams ContentSwitcher, #teams TabPane {
    height: 1fr;
}
#teams TabPane {
    padding: 0;
}
TeamView {
    height: 1fr;
}
#main {
    height: 1fr;
    padding: 0 1;
}
#lead {
    width: 1fr;
    min-width: 44;
    margin-right: 1;
}
#agents {
    width: 1fr;
    min-width: 40;
    scrollbar-size-vertical: 1;
}

/* ---- cards (Lead panel shares the look) ------------------------------------- */
.card-header {
    height: 1;
    background: $boost;
    margin-bottom: 1;
}
#lead, AgentCard {
    background: $surface;
    border: round $primary 35%;
}
#lead {
    border: round $primary 60%;
}
#lead:focus-within {
    border: round $primary;
}
#lead .card-header {
    color: $primary;
}
AgentCard {
    height: 1fr;
    min-height: 8;
    margin-bottom: 0;
    border: round $secondary 30%;
}
AgentCard .card-header {
    color: $secondary;
}
AgentCard.tester {
    border: round $success 30%;
}
AgentCard.tester .card-header {
    color: $success;
}
AgentCard.-running {
    border: round $secondary 75%;
}
AgentCard.tester.-running {
    border: round $success 75%;
}
AgentCard:focus, AgentCard:focus-within {
    border: double $secondary;
}
AgentCard.tester:focus, AgentCard.tester:focus-within {
    border: double $success;
}
AgentCard.-compacting {
    border: round $secondary 40%;
}
AgentCard.-waiting {
    border: double $warning;
}
AgentCard.-error, #lead.-error {
    border: round $error;
}
AgentCard.-error .card-header {
    color: $error;
}

/* ---- transcripts ------------------------------------------------------------- */
Transcript {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: $primary 30%;
    scrollbar-background: $surface;
}
Entry {
    margin-bottom: 1;
}
.card-log Entry {
    margin-bottom: 0;
}
.card-log Entry.text {
    color: $foreground 75%;
    max-height: 6;
    margin-bottom: 0;
}
.card-log Entry.result, .card-log Entry.prompt {
    margin-bottom: 1;
}
Entry.thinking {
    color: $foreground 50%;
}
Entry.tool {
    color: $foreground 90%;
}
Entry.tool.error {
    color: $error;
}
Entry.prompt {
    background: $boost;
    color: $foreground 80%;
    padding: 0 1;
    border-left: outer $secondary;
}
.tester Entry.prompt {
    border-left: outer $success;
}
Entry.user {
    background: $primary 12%;
    padding: 0 1;
    border-left: outer $primary;
}
Entry.notice {
    color: $primary;
}
Entry.notice.warning {
    color: $warning;
}
Entry.notice.error, Entry.result.error {
    color: $error;
}
Entry.result {
    color: $success;
}

/* The prompt boxes grow with the text, up to a few lines, then scroll. */
.command-input {
    height: auto;
    max-height: 10;
    padding: 0 1;
}
#lead-input {
    margin: 0 0;
    border: tall $primary 40%;
    background: $background;
}
#lead-input:focus {
    border: tall $primary;
}

/* ---- detail / tasks screens ------------------------------------------------- */
#detail-header {
    height: 1;
    background: $panel;
    color: $secondary;
}
.lead #detail-header {
    color: $primary;
}
.tester #detail-header {
    color: $success;
}
#detail-log {
    padding: 1 2;
}
#detail-input {
    border: tall $secondary 50%;
    margin: 0 1;
}
#detail-input:focus {
    border: tall $secondary;
}
#board {
    height: 1fr;
}
#board-table {
    width: 3fr;
    height: 1fr;
}
#board-report {
    width: 2fr;
    padding: 1 2;
    background: $surface;
    border-left: tall $panel;
}

/* ---- modals ------------------------------------------------------------------ */
ApprovalScreen, HelpScreen, ConfirmScreen {
    align: center middle;
    background: $background 60%;
}
#approval {
    width: 80;
    max-width: 95%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $surface;
    border: thick $warning;
}
#approval-title {
    margin-bottom: 1;
}
#approval-body {
    height: auto;
    max-height: 16;
    background: $panel;
    padding: 0 1;
    margin-bottom: 1;
}
#approval-buttons {
    height: auto;
    align: center middle;
}
#approval-buttons Button {
    margin: 0 1;
}
#help {
    width: 84;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

.hint {
    color: $foreground 40%;
    text-style: italic;
}

#confirm {
    width: 64;
    max-width: 95%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $error 70%;
}
#confirm-detail {
    margin-top: 1;
}
#confirm-buttons {
    height: auto;
    margin-top: 1;
    align: center middle;
}
#confirm-buttons Button {
    margin: 0 1;
}

/* ---- / command completion ------------------------------------------------- */
.command-menu {
    display: none;
    height: auto;
    max-height: 10;
    background: $panel;
    border: round $primary 50%;
    padding: 0 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    scrollbar-size-vertical: 1;
}
.command-menu > .option-list--option-highlighted {
    background: $primary 30%;
}

/* ---- accounts ----------------------------------------------------------------- */
#confirm.account {
    border: thick $primary 70%;
}
#account-list {
    height: auto;
    max-height: 12;
    margin-top: 1;
}
#account-keys {
    margin-top: 1;
}
#token-input {
    margin-top: 1;
}

/* ---- vim mode line --------------------------------------------------------------- */
#modeline {
    height: 1;
    background: $panel;
}
#mode {
    width: auto;
    max-width: 100%;
    padding: 0 1;
}
#cmdline {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $panel;
}
#cmdline:focus {
    border: none;
}
